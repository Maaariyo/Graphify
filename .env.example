# Leave all empty to run in DEMO MODE (data lives in your browser, sample Delhi places).
# Fill all three to use your real shared Supabase database (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret ("service_role" key). Used solely by /api/join to create accounts from invite links.
# Never prefix it with NEXT_PUBLIC_ and never paste it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=
